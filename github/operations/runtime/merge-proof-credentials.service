[Unit]
Description=Merge-Proof root-only workload credential materialization
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/merge-proof/current
ExecStart=/usr/local/bin/node github/operations/refresh-credentials.js /etc/merge-proof/bootstrap.json
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run
