{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:merge-proof:replay-packet:1",
  "title": "Merge Proof unsigned deterministic replay packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "trust", "verifier", "evidenceBundle", "inputs", "expected", "integrity"],
  "properties": {
    "schema": { "const": "urn:merge-proof:replay-packet:1" },
    "version": { "const": 1 },
    "trust": { "type": "object", "required": ["packetSignature", "limitation"], "properties": { "packetSignature": { "const": "UNSIGNED" }, "limitation": { "type": "string", "minLength": 1 } } },
    "verifier": { "type": "object", "required": ["engine", "version", "command"] },
    "evidenceBundle": { "type": "object" },
    "inputs": { "type": "object", "required": ["currentness", "mergeRecord", "landingObservation", "reconciliation"] },
    "expected": { "type": "object" },
    "integrity": { "type": "object", "required": ["algorithm", "payloadDigest"], "properties": { "algorithm": { "const": "sha256" }, "payloadDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
